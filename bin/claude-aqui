#!/usr/bin/env python3
"""claude-aqui - ativa 'Abrir Claude Code aqui' nos gerenciadores de arquivos."""
import os
import sys

# O `make install` troca este valor pelo diretório da biblioteca instalada.
LIB_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, LIB_DIR)

from claude_aqui.cli import main  # noqa: E402

sys.exit(main())
